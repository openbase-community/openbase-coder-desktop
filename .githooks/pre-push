#!/bin/sh
# Block pushes that would put the closed-source netmesh companion back into
# this public repository's history. The companion lives in the private
# netmesh-macos repo (see OPEN_SOURCE_BOUNDARY.md); builds use the sibling
# checkout or the signed prebuilt artifact.
#
# Standalone clones install it via the package.json "prepare" script. Inside
# the Openbase Coder multi workspace, the workspace .githooks/pre-push runs it
# after the workspace secret scan.

FORBIDDEN='^netmesh-macos/'
ZERO=0000000000000000000000000000000000000000

fail=0
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ -n "$local_sha" ] || continue
  [ "$local_sha" = "$ZERO" ] && continue # branch deletion
  if [ "$remote_sha" != "$ZERO" ] && git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
    revs=$(git rev-list "$remote_sha..$local_sha" 2>/dev/null)
  else
    # New branch, or the remote tip is unknown locally: check commits not
    # already on any remote-tracking ref.
    revs=$(git rev-list "$local_sha" --not --remotes 2>/dev/null)
  fi
  for c in $revs; do
    if git diff-tree --no-commit-id --name-only --diff-filter=d -r "$c" | grep -qE "$FORBIDDEN"; then
      echo "pre-push: BLOCKED - commit $c touches netmesh-macos/ (closed source)." >&2
      git diff-tree --no-commit-id --name-only --diff-filter=d -r "$c" | grep -E "$FORBIDDEN" | sed 's/^/  /' >&2
      fail=1
    fi
  done
done

if [ "$fail" = 1 ]; then
  echo "The netmesh companion belongs in the private netmesh-macos repo, never here." >&2
fi
exit $fail
